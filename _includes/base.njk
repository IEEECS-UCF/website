<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{#- Cloudflare Pages serves /x.html at /x and redirects the .html form, so point canonical links at /x -#}
{%- set pageUrl = config.site.url + (page.url | replace(".html", "")) -%}
{%- set pageDescription = description or config.site.description -%}
<title>{% if title %}{{ title }} · {% endif %}{{ config.site.pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
{% if noindex %}<meta name="robots" content="noindex">
{% endif %}<link rel="canonical" href="{{ pageUrl }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ config.site.pageTitle }}">
<meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ config.site.pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ config.site.url }}{{ ogImage or config.banner.src }}">
<meta property="og:image:alt" content="{{ ogImageAlt or config.banner.alt }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<link rel="icon" href="/assets/icon-48.png" type="image/png" sizes="48x48">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": config.site.pageTitle,
  "alternateName": ["IEEE CS UCF", "UCF IEEE Computer Society", "IEEE Computer Society UCF Student Chapter"],
  "url": config.site.url + "/",
  "logo": config.site.url + "/assets/logo.png",
  "description": config.site.description,
  "email": config.footer.emailText,
  "parentOrganization": { "@type": "Organization", "name": "IEEE Computer Society", "url": "https://www.computer.org/" },
  "sameAs": [config.links.instagram, config.links.linkedin, config.links.github, config.links.knightconnect, config.links.discord]
} | dump(2) | safe }}
</script>
<link rel="stylesheet" href="/assets/style.css">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<div class="shell">

<header class="masthead">
  <div>
    <p class="masthead-title">{{ config.site.title }}</p>
    <p class="masthead-sub">{{ config.site.subtitle }}</p>
  </div>
  <p class="masthead-id">{{ config.site.location }}<br>Chapter {{ config.site.chapterNo }}</p>
</header>

<div class="goldrule" role="presentation"></div>

<div class="photo-strip">
  <img src="{{ config.banner.src }}" alt="{{ config.banner.alt }}">
</div>

<nav class="nav" aria-label="Primary">
  {% for item in config.nav %}
  <a href="{{ item.href }}"{% if item.page == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
  <span class="nav-sep" aria-hidden="true">|</span>
  {% endfor %}
  <span class="nav-item-disabled" aria-disabled="true">{{ config.navDisabled }}</span>
</nav>

<div class="ticker">
  <p class="ticker-text">{{ config.ticker | join(" &bull; ") | safe }}</p>
</div>

<main id="main" class="content">
{{ content | safe }}
</main>

<footer class="footer">
  <p class="footer-legal">
    Last updated: {{ config.footer.updated }}<br>
    Maintained by <!--email_off--><a href="mailto:{{ config.footer.emailHref }}">{{ config.footer.emailText }}</a><!--/email_off--><br>
    {{ config.footer.legal | safe }}
  </p>
  <div class="footer-counter">
    <div class="counter-label">You are visitor number</div>
    <div class="counter-digits" id="counter-digits" aria-hidden="true">{{ config.counter.digits }}</div>
    <div class="counter-since">since {{ config.counter.since }}</div>
  </div>
</footer>

<ul class="badges">
  {% for badge in config.badges %}
  <li class="badge{% if badge.variant %} badge-{{ badge.variant }}{% endif %}">{% if badge.href %}<a href="{{ badge.href }}">{% endif %}{{ badge.top }}<br><b>{{ badge.bottom }}</b>{% if badge.href %}</a>{% endif %}</li>
  {% endfor %}
</ul>

</div>

<script>
  fetch("/counter")
    .then(function (r) { return r.json(); })
    .then(function (d) {
      document.getElementById("counter-digits").textContent =
        String(d.count).padStart(6, "0");
    })
    .catch(function () {});
</script>
</body>
</html>

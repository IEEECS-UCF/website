---
layout: base.njk
permalink: /projects.html
title: Projects
description: Student-led projects at IEEE Computer Society at UCF, close to the hardware. Anyone can join.
---
<h1 class="page-title">Projects</h1>

<div class="prose-block"><p>{{ projects.intro | safe }}</p></div>

<h2 class="section-head">Chapter Projects</h2>
{% for p in projects.chapter %}
<table class="table">
  <caption class="visually-hidden">{{ p.name }}</caption>
  <tbody>
    <tr><th scope="row" class="table-label">Project</th><td><b>{{ p.name }}</b> &#183; {{ p.status }}</td></tr>
    <tr><th scope="row" class="table-label">What</th><td>{{ p.summary }}</td></tr>
    <tr><th scope="row" class="table-label">Work on</th><td>{{ p.areas }}</td></tr>
    <tr><th scope="row" class="table-label">Next</th><td>{{ p.next }}</td></tr>
  </tbody>
</table>
{% endfor %}

<h2 class="section-head">Built by Our Members <span class="new-flag">New!</span></h2>
{% if projects.members.length %}
<table class="table">
  <caption class="visually-hidden">Projects members built on their own</caption>
  <tbody>
    {% for m in projects.members %}
    <tr>
      <td class="table-date">{{ m.date }}</td>
      <td><b>{% if m.href %}<a href="{{ m.href }}">{{ m.name }}</a>{% else %}{{ m.name }}{% endif %}</b> by {{ m.by }}. {{ m.summary }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
<div class="prose-block"><p>{{ projects.membersEmpty | safe }}</p></div>
{% else %}
<div class="prose-block"><p>{{ projects.membersEmpty | safe }}</p></div>
{% endif %}

<h2 class="section-head">Chapter Software</h2>
<table class="table">
  <caption class="visually-hidden">Software the chapter runs</caption>
  <tbody>
    {% for s in projects.software %}
    <tr><th scope="row" class="table-label"><a href="{{ s.href }}">{{ s.name }}</a></th><td>{{ s.summary }}</td></tr>
    {% endfor %}
  </tbody>
</table>

<h2 class="section-head">Workshop Code</h2>
<div class="prose-block"><p>Slides and code from past workshops, on our <a href="{{ config.links.github }}">GitHub</a>:</p></div>
<table class="table">
  <caption class="visually-hidden">Workshop repositories</caption>
  <tbody>
    {% for w in projects.workshops %}
    <tr><td><a href="{{ w.href }}">{{ w.name }}</a></td></tr>
    {% endfor %}
  </tbody>
</table>

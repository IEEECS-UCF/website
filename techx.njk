      <tr><td class="sig">SPEAK</td><td>Give a talk, run a workshop or join a panel. Companies and individuals can apply.</td><td class="due">{{ t.deadline }}</td><td><a href="{{ t.links.speak }}">Speaker form</a></td></tr>
      <tr><td class="sig">MENTOR</td><td>Meet students one-on-one about careers, grad school and technical topics.</td><td class="due">{{ t.deadline }}</td><td><a href="{{ t.links.mentor }}">Mentor form</a></td></tr>
      <tr><td class="sig">MENTEE</td><td>Sign up for a one-on-one with a mentor</td><td class="due">{{ t.deadline }}</td><td><a href="{{ t.links.mentee }}">Student form</a></td></tr>

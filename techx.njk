  "offers": { "@type": "Offer", "price": 0, "priceCurrency": "USD", "availability": "https://schema.org/InStock", "validFrom": "2026-09-26T00:00:00-04:00", "url": t.links.register },
  "performer": { "@type": "Organization", "name": config.site.pageTitle, "url": config.site.url + "/" },
  "organizer": { "@type": "Organization", "name": config.site.pageTitle, "url": config.site.url + "/" }
} | dump(2) | safe }}
</script>
<h1 class="page-title">TechX: Bare Metal</h1>

<ul class="techx-logos">
  <li><img class="wordmark" src="/assets/techx/techx-logo.png" alt="IEEE CS SYP TechX"></li>
  <li><img src="/assets/techx/syp80-black.png" alt="IEEE Computer Society SYP Activities, 80th anniversary"></li>
  <li><img src="/assets/techx/chapter-mark.png" alt="IEEE Computer Society at UCF"></li>
  <li class="ieee"><img src="/assets/techx/ieee-black.png" alt="IEEE"></li>
</ul>

<h2 class="section-head">Event Details</h2>
<table class="table">
  <caption class="visually-hidden">TechX: Bare Metal event details</caption>
  <tbody>
    <tr><th scope="row" class="table-label">Date</th><td>{{ t.day }}, {{ t.date }}</td></tr>
    <tr><th scope="row" class="table-label">Time</th><td>{{ t.time }}</td></tr>
    <tr><th scope="row" class="table-label">Place</th><td>{{ t.place }}, Orlando &#183; In person</td></tr>
    <tr><th scope="row" class="table-label">Cost</th><td>Completely Free!</td></tr>
  </tbody>
</table>
<p class="btn-row">
  <a class="btn btn-cta" href="{{ t.links.register }}">Register on vTools &#8594;</a>
  <a class="btn" href="/assets/techx/techx-register-flyer.png">Flyer</a>
</p>

<h2 class="section-head">Overview</h2>
<div class="prose-block">
<p>TechX: Bare Metal is a free one-day event at UCF on computer architecture and low-level programming. The day has talks, panels, workshops and Nano Mentoring.</p>
<p>We host it as part of TechX, a series of student-run events from the IEEE Computer Society's Students and Young Professionals (SYP) program. The <a href="{{ t.links.syp }}">IEEE CS SYP site</a> has more on the series, and you can email us at <!--email_off--><a href="mailto:{{ t.email }}">{{ t.email }}</a><!--/email_off--> with any questions.</p>
</div>

<h2 class="section-head">Come Join Us</h2>
<table class="table table-actions">
  <caption class="visually-hidden">Ways to take part in TechX</caption>
  <thead>
    <tr>
      <th scope="col">Role</th>
      <th scope="col">What You Do</th>
      <th scope="col">Deadline</th>
      <th scope="col">Link</th>
    </tr>
  </thead>
  <tbody>
    <tr><td class="table-role"><b>Attend</b></td><td>Come to the talks, panels and workshops</td><td class="table-date"></td><td><a href="{{ t.links.register }}">vTools</a></td></tr>
    <tr><td class="table-role"><b>Speak</b></td><td>Give a talk, run a workshop or join a panel. Companies and individuals can apply.</td><td class="table-date">{{ t.deadline }}</td><td><a href="{{ t.links.speak }}">Speaker form</a></td></tr>
    <tr><td class="table-role"><b>Mentor</b></td><td>Meet students one-on-one about careers and grad school.</td><td class="table-date">{{ t.deadline }}</td><td><a href="{{ t.links.mentor }}">Mentor form</a></td></tr>
    <tr><td class="table-role"><b>Mentee</b></td><td>Sign up for a one-on-one with a mentor</td><td class="table-date">{{ t.deadline }}</td><td><a href="{{ t.links.mentee }}">Student form</a></td></tr>
  </tbody>
</table>

<h2 class="section-head">Talk Topics</h2>
<div class="prose-block">
<ul>{% for topic in t.speakerTopics %}<li>{{ topic }}</li>{% endfor %}</ul>
<p>We're still confirming speakers. Check back here for the full schedule once it's set.</p>
</div>

<h2 class="section-head">Nano Mentoring</h2>
<div class="prose-block">
<p>Students meet one-on-one with engineers and researchers. Mentoring runs for about three hours during the event.</p>
</div>

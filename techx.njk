  "@context": "https://schema.org",
  "@type": "Event",
  "name": t.name,
  "startDate": "2027-01-23T10:30:00-05:00",
  "endDate": "2027-01-23T17:00:00-05:00",
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
